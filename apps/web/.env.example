# Copy to apps/web/.env.local for local development; set the same variables on the host (Railway).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clientes
# Secret used to hash phone numbers/emails for dedupe and suppression (any long random string).
PII_HASH_SECRET=change-me-to-a-long-random-string
# Admin console login (Phase 0: single owner account).
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session cookie (any long random string).
ADMIN_SESSION_SECRET=change-me-to-another-long-random-string
# Set to "true" once the TrustedForm account exists.
TRUSTEDFORM_ENABLED=false
# Buyer outreach emails (Admin → Buyer finder).
# Optional: Claude API key for AI-drafted emails; without it a built-in template is used.
ANTHROPIC_API_KEY=
OUTREACH_SENDER_NAME=Your Name
BUSINESS_NAME=Your Business LLC
# Physical mailing address (CAN-SPAM requires it in commercial email).
BUSINESS_MAILING_ADDRESS=123 Main St, Miami, FL 33101
# Search engines: keep "false" until counsel has approved the consent text and you are ready for traffic.
ALLOW_INDEXING=false
